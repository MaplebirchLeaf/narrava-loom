{
  "name": "narrava-loom-twee",
  "displayName": "Narrava Loom Twee",
  "version": "0.4.0",
  "description": "Narrava Loom .twee language highlighting and editing support",
  "categories": [
    "Programming Languages"
  ],
  "publisher": "narrava-loom",
  "files": [
    "extension.js",
    "src/**",
    "references/**",
    "language-configuration.json",
    "syntaxes/**",
    "README.md"
  ],
  "main": "./extension.js",
  "scripts": {
    "test": "node tests/catalog.mjs && node tests/verify.mjs"
  },
  "devDependencies": {
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "contributes": {
    "languages": [
      {
        "id": "narrava-twee",
        "aliases": [
          "Narrava Twee",
          "Twee"
        ],
        "extensions": [
          ".twee"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "narrava-twee",
        "scopeName": "source.narrava-twee",
        "path": "./syntaxes/narrava-twee.tmLanguage.json"
      }
    ]
  },
  "engines": {
    "vscode": "^1.85.0"
  }
}
