{
  "name": "narrava-loom-twee",
  "displayName": "Narrava Loom Twee",
  "version": "0.10.0",
  "description": "Narrava Loom .twee language highlighting and editing support",
  "categories": [
    "Programming Languages"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/MaplebirchLeaf/narrava-loom.git",
    "directory": "editors/vscode-narrava-loom"
  },
  "publisher": "narrava-loom",
  "files": [
    "extension.js",
    "src/**",
    "references/**",
    "language-configuration.json",
    "syntaxes/**",
    "README.md"
  ],
  "main": "./extension.js",
  "scripts": {
    "test": "node tests/catalog.mjs && node tests/verify.mjs && node tests/providers.mjs && node tests/macro-highlights.mjs"
  },
  "devDependencies": {
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "contributes": {
    "configuration": {
      "title": "Narrava Loom Twee",
      "properties": {
        "narravaTwee.macroTagMatching": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "加粗并下划线标记光标所在容器宏的首尾标签。"
        }
      }
    },
    "languages": [
      {
        "id": "narrava-twee",
        "aliases": [
          "Narrava Twee",
          "Twee"
        ],
        "extensions": [
          ".twee"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "narrava-twee",
        "scopeName": "source.narrava-twee",
        "path": "./syntaxes/narrava-twee.tmLanguage.json"
      }
    ]
  },
  "engines": {
    "vscode": "^1.85.0"
  }
}
