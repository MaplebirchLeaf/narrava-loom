{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "ignorePatterns": ["dist/**", "node_modules/**", "target/**", "hosts/narrava-loom-tauri/gen/**"],
  "rules": {
    "no-underscore-dangle": [
      "error",
      {
        "allow": [
          "__TAURI__",
          "__narrava",
          "__narravaCallable",
          "__narravaConsoleIsProxy",
          "__narravaReactionAdd",
          "__narravaReactionDisable",
          "__narravaReactionEnable",
          "__narravaReactionGet",
          "__narravaReactionReset",
          "__narravaResourceHas",
          "__narravaResourceInfo",
          "__narravaResourcePaths",
          "__narravaResourceRead",
          "__narravaResourceText",
          "__narravaStateDel",
          "__narravaStateGet",
          "__narravaStateHas",
          "__narravaStateReplace",
          "__narravaStateSet",
          "__narravaStateSnapshot",
          "__narravaLocationAdd",
          "__narravaLocationGet",
          "__narravaLocationPlaces",
          "__narravaLocationLocate",
          "__narravaLocationCurrent",
          "__narravaLocationMove",
          "__narravaRandomNext",
          "__narravaRandomSeed",
          "__narravaRandomCurrent",
          "__narravaLoggerLog",
          "__narravaLoggerSubscribe",
          "__narravaLoggerTake",
          "__narravaLoggerUnsubscribe"
        ]
      }
    ],
    "unicorn/require-module-specifiers": "off"
  }
}
